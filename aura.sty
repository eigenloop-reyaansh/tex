\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{aura}
\RequirePackage{amsmath,amssymb,amsfonts,amsthm}
\RequirePackage{geometry}
\RequirePackage{xcolor}
\RequirePackage{hyperref}
\RequirePackage{bookmark}
\RequirePackage{tcolorbox}
\RequirePackage{microtype}
\RequirePackage{kvoptions}

\SetupKeyvalOptions{family=AURA,prefix=AURA@}

\DeclareBoolOption[false]{minimal}
\DeclareBoolOption[true]{colored}

\ProcessKeyvalOptions*

\ifAURA@minimal
  \geometry{margin=1.15in}
\else
  \geometry{left=1in,right=1in,top=1in,bottom=1in}
\fi


\definecolor{aurablue}{HTML}{2455A4}
\definecolor{auragreen}{HTML}{2F7D4A}
\definecolor{aurared}{HTML}{B23A48}
\definecolor{auragray}{HTML}{555555}

\definecolor{aurablueback}{HTML}{F3F6FB}
\definecolor{auragreenback}{HTML}{F3F8F4}
\definecolor{auraredback}{HTML}{FBF4F5}
\definecolor{auragrayback}{HTML}{F7F7F7}


\hypersetup{
  colorlinks=true,
  linkcolor=aurablue,
  citecolor=aurablue,
  urlcolor=aurablue
}

% ============================================================
% Box styles
% ============================================================

\tcbuselibrary{theorems,skins,breakable}

\tcbset{
  aura/theorem/.style={
    enhanced, breakable,
    colback=aurablueback, colframe=aurablue, coltitle=black,
    boxrule=0pt, leftrule=2pt, rightrule=0pt, toprule=0pt, bottomrule=0pt,
    sharp corners,
    left=8pt, right=6pt, top=5pt, bottom=5pt,
    fonttitle=\bfseries, fontupper=\normalfont,
    separator sign={\;}, description delimiters={(}{)},
    theorem style=plain
  },
  aura/claim/.style={
    enhanced, breakable,
    colback=auragreenback, colframe=auragreen, coltitle=black,
    boxrule=0pt, leftrule=2pt, rightrule=0pt, toprule=0pt, bottomrule=0pt,
    sharp corners,
    left=8pt, right=6pt, top=5pt, bottom=5pt,
    fonttitle=\bfseries, fontupper=\normalfont,
    separator sign={\;}, description delimiters={(}{)},
    theorem style=plain
  },
  aura/example/.style={
    enhanced, breakable,
    colback=auraredback, colframe=aurared, coltitle=black,
    boxrule=0pt, leftrule=2pt, rightrule=0pt, toprule=0pt, bottomrule=0pt,
    sharp corners,
    left=8pt, right=6pt, top=5pt, bottom=5pt,
    fonttitle=\bfseries, fontupper=\normalfont,
    separator sign={\;}, description delimiters={(}{)},
    theorem style=plain
  },
  aura/plain/.style={
    enhanced, breakable,
    colback=auragrayback, colframe=auragray, coltitle=black,
    boxrule=0pt, leftrule=2pt, rightrule=0pt, toprule=0pt, bottomrule=0pt,
    sharp corners,
    left=8pt, right=6pt, top=5pt, bottom=5pt,
    fonttitle=\bfseries, fontupper=\normalfont,
    separator sign={\;}, description delimiters={(}{)},
    theorem style=plain
  }
}

% ============================================================
% Theorem environments
% ============================================================

\ifAURA@colored

  \newtcbtheorem[number within=section]{theorem}{Theorem}{aura/theorem}{thm}
  \newtcbtheorem[use counter=theorem]{lemma}{Lemma}{aura/theorem}{lem}
  \newtcbtheorem[use counter=theorem]{proposition}{Proposition}{aura/theorem}{prop}
  \newtcbtheorem[use counter=theorem]{corollary}{Corollary}{aura/theorem}{cor}
  \newtcbtheorem[use counter=theorem]{claim}{Claim}{aura/claim}{clm}
  \newtcbtheorem[use counter=theorem]{algorithm}{Algorithm}{aura/claim}{alg}
  \newtcbtheorem[use counter=theorem]{example}{Example}{aura/example}{ex}
  \newtcbtheorem[use counter=theorem]{definition}{Definition}{aura/plain}{def}
  \newtcbtheorem[use counter=theorem]{remark}{Remark}{aura/plain}{rem}
  \newtcbtheorem[use counter=theorem]{problem}{Problem}{aura/plain}{prob}
  \newtcbtheorem[use counter=theorem]{exercise}{Exercise}{aura/plain}{exc}

\else

  \newtheorem{theorem}{Theorem}[section]
  \newtheorem{lemma}[theorem]{Lemma}
  \newtheorem{proposition}[theorem]{Proposition}
  \newtheorem{corollary}[theorem]{Corollary}
  \newtheorem{claim}[theorem]{Claim}
  \newtheorem{algorithm}[theorem]{Algorithm}
  \newtheorem{example}[theorem]{Example}
  \newtheorem{definition}[theorem]{Definition}
  \newtheorem{remark}[theorem]{Remark}
  \newtheorem{problem}[theorem]{Problem}
  \newtheorem{exercise}[theorem]{Exercise}

\fi


