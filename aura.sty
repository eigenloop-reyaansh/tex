\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{aura}[2026/09/17 v0.2 Aura document style]



\RequirePackage{amsmath,amssymb,amsfonts,amsthm}
\RequirePackage{geometry}
\RequirePackage{xcolor}
\RequirePackage{hyperref}
\RequirePackage{bookmark}
\RequirePackage{tcolorbox}
\RequirePackage{microtype}
\RequirePackage{kvoptions}

% ------------------------------------------------------------
% Package options
% ------------------------------------------------------------

\SetupKeyvalOptions{family=AURA,prefix=AURA@}

\DeclareBoolOption[false]{minimal}
\DeclareBoolOption[true]{colored}
\DeclareBoolOption[true]{seccolored}

\ProcessKeyvalOptions*

% ------------------------------------------------------------
% Page geometry
% ------------------------------------------------------------

\ifAURA@minimal
  \geometry{margin=1.15in}
\else
  \geometry{left=1in,right=1in,top=1in,bottom=1in}
\fi

% ------------------------------------------------------------
% Colors
% ------------------------------------------------------------

\definecolor{aurablue}{HTML}{2455A4}
\definecolor{auragreen}{HTML}{2F7D4A}
\definecolor{aurared}{HTML}{B23A48}
\definecolor{auragray}{HTML}{555555}

\definecolor{aurablueback}{HTML}{F3F6FB}
\definecolor{auragreenback}{HTML}{F3F8F4}
\definecolor{auraredback}{HTML}{FBF4F5}
\definecolor{auragrayback}{HTML}{F7F7F7}
\definecolor{aurasection}{HTML}{2F5263}

% ------------------------------------------------------------
% Hyperlinks
% ------------------------------------------------------------

\hypersetup{
  colorlinks=true,
  linkcolor=aurablue,
  citecolor=aurablue,
  urlcolor=aurablue
}

% ============================================================
% Box styles
% ============================================================

\tcbuselibrary{theorems,skins,breakable}

\tcbset{
  aura/theorem/.style={
    enhanced,
    breakable,
    colback=aurablueback,
    colframe=aurablue,
    coltitle=aurablue,
    boxrule=0pt,
    leftrule=2pt,
    rightrule=0pt,
    toprule=0pt,
    bottomrule=0pt,
    sharp corners,
    left=8pt,
    right=6pt,
    top=5pt,
    bottom=5pt,
    fonttitle=\sffamily\bfseries,
    fontupper=\normalfont,
    theorem style=plain
  },
  aura/claim/.style={
    enhanced,
    breakable,
    colback=auragreenback,
    colframe=auragreen,
    coltitle=auragreen,
    boxrule=0pt,
    leftrule=2pt,
    rightrule=0pt,
    toprule=0pt,
    bottomrule=0pt,
    sharp corners,
    left=8pt,
    right=6pt,
    top=5pt,
    bottom=5pt,
    fonttitle=\sffamily\bfseries,
    fontupper=\normalfont,
    theorem style=plain
  },
  aura/example/.style={
    enhanced,
    breakable,
    colback=auraredback,
    colframe=aurared,
    coltitle=black,
    boxrule=0pt,
    leftrule=2pt,
    rightrule=0pt,
    toprule=0pt,
    bottomrule=0pt,
    sharp corners,
    left=8pt,
    right=6pt,
    top=5pt,
    bottom=5pt,
    fonttitle=\sffamily\bfseries,
    fontupper=\normalfont,
    theorem style=plain
  },
  aura/plain/.style={
    enhanced,
    breakable,
    colback=auragrayback,
    colframe=auragray,
    coltitle=black,
    boxrule=0pt,
    leftrule=2pt,
    rightrule=0pt,
    toprule=0pt,
    bottomrule=0pt,
    sharp corners,
    left=8pt,
    right=6pt,
    top=5pt,
    bottom=5pt,
    fonttitle=\sffamily\bfseries,
    fontupper=\normalfont,
    theorem style=plain
  }
}

\ifAURA@seccolored
  \@ifundefined{KOMAClassName}{}{
    \renewcommand*{\sectionformat}{%
      \color{aurasection}\S\thesection\enskip
    }

    \renewcommand*{\subsectionformat}{%
      \color{aurasection}\S\thesubsection\enskip
    }

    \renewcommand*{\subsubsectionformat}{%
      \color{aurasection}\S\thesubsubsection\enskip
    }

    \addtokomafont{section}{\color{aurasection}}
    \addtokomafont{subsection}{\color{aurasection}}
    \addtokomafont{subsubsection}{\color{aurasection}}

    \KOMAoptions{numbers=noenddot}
  }
\fi


% ============================================================
% Theorem environments
% ============================================================

\ifAURA@colored

  \newtcbtheorem[
    number within=section
  ]{theorem}{Theorem}{aura/theorem}{thm}

  \newtcbtheorem[
    use counter from=theorem
  ]{lemma}{Lemma}{aura/theorem}{lem}

  \newtcbtheorem[
    use counter from=theorem
  ]{proposition}{Proposition}{aura/theorem}{prop}

  \newtcbtheorem[
    use counter from=theorem
  ]{corollary}{Corollary}{aura/theorem}{cor}

  \newtcbtheorem[
    use counter from=theorem
  ]{claim}{Claim}{aura/claim}{clm}

  \newtcbtheorem[
    use counter from=theorem
  ]{algorithm}{Algorithm}{aura/claim}{alg}

  \newtcbtheorem[
    use counter from=theorem
  ]{example}{Example}{aura/example}{ex}

  \newtcbtheorem[
    use counter from=theorem
  ]{definition}{Definition}{aura/plain}{def}

  \newtcbtheorem[
    use counter from=theorem
  ]{remark}{Remark}{aura/plain}{rem}

  \newtcbtheorem[
    use counter from=theorem
  ]{problem}{Problem}{aura/plain}{prob}

  \newtcbtheorem[
    use counter from=theorem
  ]{exercise}{Exercise}{aura/plain}{exc}

\else

  \newtheorem{theorem}{Theorem}[section]
  \newtheorem{lemma}[theorem]{Lemma}
  \newtheorem{proposition}[theorem]{Proposition}
  \newtheorem{corollary}[theorem]{Corollary}
  \newtheorem{claim}[theorem]{Claim}
  \newtheorem{algorithm}[theorem]{Algorithm}
  \newtheorem{example}[theorem]{Example}
  \newtheorem{definition}[theorem]{Definition}
  \newtheorem{remark}[theorem]{Remark}
  \newtheorem{problem}[theorem]{Problem}
  \newtheorem{exercise}[theorem]{Exercise}

\fi

% ============================================================
% Common notation
% ============================================================

\newcommand{\NN}{\mathbb{N}}
\newcommand{\ZZ}{\mathbb{Z}}
\newcommand{\QQ}{\mathbb{Q}}
\newcommand{\RR}{\mathbb{R}}
\newcommand{\CC}{\mathbb{C}}

\newcommand{\dang}{\measuredangle}
\newcommand{\half}{\frac{1}{2}}
\newcommand{\dg}{^\circ}

% ============================================================
% Mathematical utilities
% ============================================================

\newcommand{\diff}{\mathop{}\!\mathrm{d}}
\newcommand{\eval}[2]{\left.#1\right|_{#2}}
\newcommand{\norm}[1]{\left\lVert#1\right\rVert}
\newcommand{\inner}[2]{\left\langle #1,#2 \right\rangle}

% ------------------------------------------------------------
% End of package
% ------------------------------------------------------------

\endinput

